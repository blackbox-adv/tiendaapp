# ========================================
# INSTRUCCIONES DE DESPLIEGUE
# ========================================
#
# 1. Ejecuta el SQL en Supabase (SQL Editor)
# 2. Copia este archivo como .env y llena los valores
# 3. npm install
# 4. npx prisma generate
# 5. npm run dev (local) o despliega en Vercel
#
# ========================================

# Supabase - Obtén estos valores en Supabase → Settings → Database
# Use Transaction pooler URL (port 6543) for DATABASE_URL
# Use Session pooler URL (port 5432) for DIRECT_URL
DATABASE_URL="postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:5432/postgres"

# En Vercel, agrega estas mismas variables en:
# Settings → Environment Variables

# Supabase Storage - Obtén estos valores en Supabase → Settings → API
SUPABASE_URL="https://TU_PROYECTO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="TU_SERVICE_ROLE_KEY_AQUI"
NEXT_PUBLIC_SUPABASE_URL="https://TU_PROYECTO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="TU_ANON_KEY_AQUI"

# Resend - Email transaccional (obten tu key en resend.com)
RESEND_API_KEY=re_TU_API_KEY_AQUI

# JWT Secret - Clave para firmar tokens de autenticacion (min 16 caracteres, generar con: openssl rand -hex 32)
JWT_SECRET=TU_JWT_SECRET_AQUI_MIN_32_CHARS

# Webhook Secret - Clave para verificar webhooks de pagos (min 16 caracteres)
WEBHOOK_SECRET=TU_WEBHOOK_SECRET_AQUI_MIN_32_CHARS

# Admin Reset Code - Cambiar después del primer uso!
ADMIN_RESET_CODE=TU_RESET_CODE_AQUI

NEXT_PUBLIC_APP_URL=https://tienda.blackboxperu.com
